{
	"name": "pi-roundtable",
	"version": "0.2.0",
	"description": "A plugin-driven Pi agent server for Discord",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts",
		"./kit": "./src/kit/index.ts",
		"./discord": "./src/discord/index.ts"
	},
	"bin": {
		"roundtable": "./src/cli/roundtable.mjs"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/core/testing/file-size.ts",
		"!src/cli/testing",
		"templates",
		"docs",
		"examples",
		"!examples/guide.test.ts",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wayne930242/pi-roundtable.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test"
	},
	"dependencies": {
		"@babel/parser": "7.29.9",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"canvas": "3.2.3",
		"discord.js": "14.27.0",
		"pi-mcp-adapter": "2.37.0",
		"pi-web-access": "0.35.0",
		"pino": "10.3.1",
		"typebox": "1.3.34",
		"unpdf": "1.8.1"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"@biomejs/biome": "2.5.14",
		"@types/bun": "1.4.2"
	}
}
