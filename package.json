{
	"name": "pi-roundtable",
	"version": "0.7.19",
	"description": "A plugin-driven Pi agent server for one owner, reached through Discord or the web",
	"type": "module",
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"overrides": {
		"pi-roundtable": "link:."
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts",
		"./kit": "./src/kit/index.ts",
		"./discord": "./src/discord/index.ts"
	},
	"bin": {
		"roundtable": "src/cli/roundtable.mjs"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/core/testing/file-size.ts",
		"!src/cli/testing",
		"templates",
		"docs",
		"examples",
		"!examples/guide.test.ts",
		"LICENSE",
		"README.md",
		"README.zh-TW.md",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wayne930242/pi-roundtable.git"
	},
	"homepage": "https://pi-roundtable.wayneh.tw",
	"bugs": {
		"url": "https://github.com/wayne930242/pi-roundtable/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test ./src ./scripts ./examples",
		"check:packages": "bun run --workspaces typecheck && bun run --workspaces lint && bun run --workspaces test"
	},
	"dependencies": {
		"@babel/parser": "7.29.9",
		"@babel/types": "7.29.8",
		"@earendil-works/pi-ai": ">=0.99.2 <2",
		"@earendil-works/pi-coding-agent": ">=0.99.2 <2",
		"canvas": "3.2.3",
		"discord.js": "14.27.0",
		"pi-jev-compaction": "1.0.0",
		"pi-mcp-adapter": "5.0.0",
		"pino": "10.3.1",
		"typebox": "1.3.34",
		"unpdf": "1.8.1"
	},
	"peerDependencies": {
		"pi-web-access": ">=0.35.0 <0.36.0"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"pi-self-compact": "0.2.0",
		"pi-web-access": "0.35.0"
	}
}
