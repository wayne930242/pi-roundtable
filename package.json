{
	"name": "pi-roundtable-sandbox",
	"version": "0.1.0",
	"description": "Sealed guest channels and an allow-listed credential broker for pi-roundtable",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.4.2"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"worker",
		"!worker/**/*.test.ts",
		"examples",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check ."
	},
	"peerDependencies": {
		"pi-roundtable": ">=0.6.1 <0.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"discord.js": "14.27.0",
		"pi-roundtable": "0.6.1",
		"typescript": "7.0.2"
	}
}
