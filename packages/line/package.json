{
	"name": "pi-roundtable-line",
	"version": "0.20.0",
	"description": "A LINE Messaging API transport for pi-roundtable: a signed webhook that persists events before it answers, a durable inbox worker, and an allowlist of the groups and chats it mirrors",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/testing",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wayne930242/pi-roundtable.git",
		"directory": "packages/line"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test"
	},
	"peerDependencies": {
		"pi-roundtable": ">=0.20.0 <0.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-ai": ">=1.0.0 <2",
		"@earendil-works/pi-coding-agent": ">=1.0.0 <2",
		"@types/bun": "1.4.3",
		"pi-roundtable": "0.20.0",
		"typebox": "1.3.37",
		"typescript": "7.0.2"
	}
}
