{
	"name": "pi-roundtable-browser",
	"version": "0.26.1",
	"description": "A browser worker for pi-roundtable agents: agent-browser in a Docker container with no route to the host's networks",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wayne930242/pi-roundtable.git",
		"directory": "packages/browser"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/testing",
		"docker",
		"examples",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check ."
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0 <2",
		"typebox": "1.3.37"
	},
	"peerDependencies": {
		"pi-roundtable": ">=0.26.0 <0.27.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"pi-roundtable": "0.26.1",
		"typescript": "7.0.2"
	}
}
