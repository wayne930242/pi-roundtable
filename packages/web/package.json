{
	"name": "pi-roundtable-web",
	"version": "0.7.8",
	"description": "An owner-only web console for pi-roundtable: conversations, transcripts, and memory notes, with live updates",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/testing",
		"dist",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wayne930242/pi-roundtable.git",
		"directory": "packages/web"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"prepack": "bun scripts/build.ts",
		"fixture": "bun scripts/fixture-host.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web",
		"lint": "biome check .",
		"test": "bun test"
	},
	"dependencies": {
		"jose": "6.2.12"
	},
	"peerDependencies": {
		"pi-roundtable": ">=0.7.0 <0.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"pi-roundtable": "0.7.8",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"typescript": "7.0.2"
	}
}
