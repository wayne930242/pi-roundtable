{
	"name": "pi-roundtable-web",
	"version": "0.29.0",
	"description": "A web console for the owners of a pi-roundtable host: conversations, transcripts, and memory notes, with live updates",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.4.4"
	},
	"exports": {
		".": "./src/index.ts",
		"./push-sender": "./src/push-sender/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/testing",
		"dist",
		"assets",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wayne930242/pi-roundtable.git",
		"directory": "packages/web"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"prepack": "bun scripts/build.ts",
		"fixture": "bun scripts/fixture-host.ts",
		"fixture:app": "bun scripts/fixture-app.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web",
		"lint": "biome check .",
		"test": "bun test"
	},
	"dependencies": {
		"jose": "6.2.12"
	},
	"peerDependencies": {
		"pi-roundtable": ">=0.29.0 <0.30.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-go": "6.0.1",
		"@codemirror/lang-html": "6.4.12",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/lang-python": "6.2.1",
		"@codemirror/lang-rust": "6.0.2",
		"@codemirror/lang-sql": "6.10.0",
		"@codemirror/lang-xml": "6.1.0",
		"@codemirror/lang-yaml": "6.1.3",
		"@codemirror/language": "6.13.1",
		"@codemirror/legacy-modes": "6.5.5",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@happy-dom/global-registrator": "21.0.4",
		"@lezer/highlight": "1.2.5",
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.186.0",
		"pi-roundtable": "0.29.0",
		"react": "19.3.1",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"three": "0.186.1",
		"typescript": "7.0.2"
	}
}
