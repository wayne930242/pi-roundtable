# Copy this file to .env and fill it in. Bun loads .env by itself; never commit it.

# Discord: https://discord.com/developers/applications (create an application, add a bot).
# The bot needs the Message Content intent (Bot page) and an invite to your server.
DISCORD_TOKEN=
# Turn on Developer Mode in Discord, then right-click the server and the channel to copy their ids.
DISCORD_GUILD_ID=
DISCORD_ENTRY_CHANNEL_ID=

# You: the one owner who can change everything (right-click your name, Copy User ID).
OWNER_ID=
OWNER_NAME=

# PostgreSQL. This matches docker-compose.yml: run `docker compose up -d`.
DATABASE_URL=postgres://roundtable:roundtable@localhost:5432/roundtable

# The agents' model as <provider>/<id>, and the provider's API key (or log in with Pi and leave the key out).
MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# The address that reaches this process from the internet; it serves the agents' avatars.
PUBLIC_URL=
