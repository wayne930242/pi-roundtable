# Copy this file to .env and fill it in. Bun loads .env by itself; never commit it.

# You: the operator who runs this host, named in the assistant's prompts.
OWNER_NAME=

# PostgreSQL. This matches docker-compose.yml: run `docker compose up -d`.
DATABASE_URL=postgres://roundtable:roundtable@localhost:5432/roundtable

# The assistant's model as <provider>/<id>, and the provider's API key (or log in with Pi and leave the key out).
MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Your OpenID Connect provider: register this API there, then copy its issuer (iss), the API's
# audience (aud), and the provider's signing keys address (jwks_uri in its discovery document).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Who may chat: the role names your provider puts in the token's roles claim, comma-separated.
CHAT_MEMBER_ROLES=
# CHAT_ADMIN_ROLES=

# The origins of the web pages that open the chat, comma-separated, such as https://chat.example.com.
CHAT_ORIGINS=
